{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./web",
    "types": [],
    "paths": {
      "@/*": ["./web/*"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"],
  "exclude": ["web/node_modules", "data", "etl"]
}
